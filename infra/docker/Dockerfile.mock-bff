# 모의 BFF 단독 이미지 (앱 팀이 맥 IP 없이 붙을 때)
#   docker build -f infra/docker/Dockerfile.mock-bff -t colorsense-mock-bff . && docker run -p 8787:8787 colorsense-mock-bff
FROM node:22-alpine
WORKDIR /repo
COPY backend/mock-bff ./backend/mock-bff
COPY frontend/src/lib/kma.js frontend/src/lib/model.js ./frontend/src/lib/
COPY database/catalog.json ./database/catalog.json
ENV PORT=8787
EXPOSE 8787
CMD ["node", "backend/mock-bff/server.mjs"]
