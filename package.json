{
  "name": "colorsense",
  "private": true,
  "description": "ColorSense — 날씨를 색으로 보여주는 앱 (모노레포 루트)",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "npm --prefix frontend run dev:mock",
    "dev:live": "npm --prefix frontend run dev",
    "mock": "node backend/mock-bff/server.mjs",
    "bff": "bash scripts/bff.sh",
    "bff:dev": "bash scripts/bff.sh dev",
    "test": "npm --prefix frontend test && npm --prefix packages/core test && npm --prefix backend/bff test",
    "check": "npm test && npm --prefix frontend run build",
    "golden": "npm --prefix frontend run golden",
    "smoke": "npm --prefix frontend run smoke",
    "build": "npm --prefix frontend run build",
    "docker": "docker compose -f infra/docker/docker-compose.yml up"
  }
}
