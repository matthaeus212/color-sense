{
  "name": "colorsense-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ColorSense — a weather app that shows real location, weather and time as color. React refactor.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "golden": "node scripts/gen-golden.mjs",
    "smoke": "node scripts/catalog-smoke.mjs",
    "dev:mock": "node scripts/dev-mock.mjs",
    "mock": "node ../backend/mock-bff/server.mjs",
    "check": "npm test && vite build --outDir .vite-check --emptyOutDir"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^6.4.3"
  }
}
